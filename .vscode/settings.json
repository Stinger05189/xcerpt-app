{
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,
  "js/ts.suggestionActions.enabled": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.rules.customizations": [
    { "rule": "@typescript-eslint/no-unused-vars", "severity": "warn" },
    { "rule": "react-hooks/exhaustive-deps", "severity": "warn" }
  ]
}